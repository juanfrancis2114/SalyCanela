# ============================================================
#  Variables de entorno del BACKEND — Sal y Canela (Reto 2)
#  Copia este archivo a ".env" y completa con tus credenciales.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ---- Base de datos (Supabase / PostgreSQL) ----
# URL "pooled" (PgBouncer, puerto 6543) usada por la app en runtime.
# La encuentras en Supabase: Project Settings > Database > Connection string > "Transaction"
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL "directa" (puerto 5432) usada por Prisma SOLO para migraciones.
# En Supabase: Connection string > "Session"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ---- Servidor ----
PORT=4000
NODE_ENV=development

# ---- Seguridad / JWT ----
# Genera uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="2h"

# ---- CORS ----
# Origen EXACTO del frontend (sin "/" final). En producción nunca uses "*".
CORS_ORIGIN="http://localhost:5173"
